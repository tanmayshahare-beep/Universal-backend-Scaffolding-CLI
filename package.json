{
  "name": "skeletal-dock",
  "version": "1.0.0",
  "description": "Universal backend scaffold with CLI configurator",
  "main": "gui/main.js",
  "bin": {
    "skeletal": "./cli/index.js"
  },
  "scripts": {
    "start": "node start.js",
    "setup": "node cli/index.js init",
    "status": "node cli/index.js status",
    "add-model": "node cli/index.js add-model",
    "demo:setup": "node demo/setup-demo.js",
    "demo": "node demo/server.js",
    "gui": "electron gui/main.js",
    "package": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.skeletaldock.app",
    "productName": "Skeletal Dock",
    "copyright": "Made with love and Claude",
    "asar": false,
    "forceCodeSigning": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!.git/**",
      "!.claude/**",
      "!*.md",
      "!INSTRUCTIONS.txt"
    ],
    "win": {
      "target": "portable",
      "icon": "ascii-art.png",
      "artifactName": "SkeltalDock.exe",
      "signAndEditExecutable": false
    }
  },
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "chalk": "^4.1.2",
    "commander": "^11.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "inquirer": "^8.2.6",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.7",
    "socket.io": "^4.6.1",
    "twilio": "^4.19.0",
    "uuid": "^9.0.0"
  }
}
